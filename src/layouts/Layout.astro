---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { loadSeoDefaults, resolveSeoMeta } from '../api/site';

interface Alternate {
  lang: string;
  path: string;
}

interface Props {
  // Page-specific title. Inner pages pass their own (a suffix is appended);
  // the homepage passes none, so the site-wide default title is used as-is.
  title?: string;
  // Page-specific meta description; falls back to the site-wide default.
  description?: string;
  lang?: string;
  // Canonical path (defaults to the current path). Resolved to an absolute URL
  // against `site` for correct SEO.
  canonical?: string;
  // hreflang alternates (per-locale equivalents + x-default). Empty when a
  // page has no cross-language equivalent (e.g. a category without a ru slug).
  alternates?: Alternate[];
  // schema.org structured data blocks, each emitted as a ld+json script.
  jsonLd?: Record<string, unknown>[];
  // Open Graph image URL; falls back to the site-wide default OG image.
  ogImage?: string;
  // Open Graph type — 'website' for listings, 'product' for product pages.
  ogType?: string;
}

const {
  title,
  description,
  lang = 'ro',
  canonical,
  alternates = [],
  jsonLd = [],
  ogImage,
  ogType = 'website',
} = Astro.props;

// Site-wide SEO defaults (cached, back-office-managed), composed with the page's
// own overrides into the final meta (see resolveSeoMeta). Everything degrades to
// a bare fallback if the defaults are unset/unreachable, so meta is always
// well-formed.
const seo = await loadSeoDefaults();
const {
  title: metaTitle,
  description: metaDescription,
  ogImage: ogImageUrl,
} = resolveSeoMeta(seo, { lang, title, description, ogImage });

const site = Astro.site ?? new URL('http://localhost:4321');
const canonicalURL = new URL(canonical ?? Astro.url.pathname, site).href;
// Pre-launch: keep the store out of search indexes. Runtime flag so launch is
// just `SITE_NOINDEX=false` + restart (no rebuild). Also drives robots.txt.
const noindex = import.meta.env.SSR && process.env.SITE_NOINDEX === 'true';
const alternateLinks = alternates.map((a) => ({
  hreflang: a.lang,
  href: new URL(a.path, site).href,
}));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Onest:wght@300;400;500;600;700;900&display=swap"
      rel="stylesheet"
    />
    <title>{metaTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="evix" />
    <meta property="og:title" content={metaTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={metaTitle} />
    <meta name="twitter:description" content={metaDescription} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
    {
      alternateLinks.map((a) => (
        <link rel="alternate" hreflang={a.hreflang} href={a.href} />
      ))
    }
    {
      jsonLd.map((block) => (
        <script type="application/ld+json" set:html={JSON.stringify(block)} />
      ))
    }
  </head>
  <body class="flex min-h-screen flex-col bg-white text-body antialiased">
    <Header lang={lang} alternates={alternates} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
