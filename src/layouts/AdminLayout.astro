---
import '../styles/global.css';
import { pendingReviewsCount } from '../lib/admin-badges';

interface Props {
  title?: string;
  // Staff email shown in the top bar; omitted on the login page.
  email?: string;
  // Active section key for sidebar highlighting.
  active?: string;
}

const { title = 'Админка', email, active = '' } = Astro.props;

// Reviews-queue badge: number awaiting moderation (SSR, best-effort → 0).
const reviewsPending = await pendingReviewsCount(Astro.cookies);

const NAV: { key: string; href: string; label: string; badge?: number }[] = [
  { key: 'dashboard', href: '/admin', label: 'Дашборд' },
  { key: 'products', href: '/admin/products', label: 'Товары' },
  { key: 'categories', href: '/admin/categories', label: 'Категории' },
  { key: 'promotions', href: '/admin/promotions', label: 'Акции' },
  { key: 'promo', href: '/admin/promo', label: 'Промокоды' },
  { key: 'orders', href: '/admin/orders', label: 'Заказы' },
  { key: 'customers', href: '/admin/customers', label: 'Клиенты' },
  {
    key: 'reviews',
    href: '/admin/reviews',
    label: 'Отзывы',
    badge: reviewsPending,
  },
  { key: 'support', href: '/admin/support', label: 'Поддержка' },
  { key: 'analytics', href: '/admin/analytics', label: 'Аналитика' },
  { key: 'demand', href: '/admin/demand', label: 'Спрос' },
  { key: 'content', href: '/admin/content-pages', label: 'Страницы' },
  { key: 'settings', href: '/admin/settings/staff', label: 'Настройки' },
];
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0F172A" />
    <title>{title} — evix admin</title>
  </head>
  <body class="min-h-screen bg-fill text-body antialiased">
    <div class="flex min-h-screen">
      <!-- Sidebar -->
      <aside
        class="flex w-56 shrink-0 flex-col border-r-2 border-fill bg-white"
      >
        <a
          href="/admin"
          class="flex h-16 items-center px-6 text-lg font-bold text-ink"
        >
          evix<span class="text-primary">admin</span>
        </a>
        <nav class="flex-1 px-3 py-2">
          {
            NAV.map((item) => (
              <a
                href={item.href}
                class:list={[
                  'mb-1 flex items-center justify-between rounded-xl px-3 py-2 text-sm font-medium transition-colors',
                  active === item.key
                    ? 'bg-primary text-white'
                    : 'text-body hover:bg-fill',
                ]}
              >
                <span>{item.label}</span>
                {item.key === 'reviews' ? (
                  <span
                    id="reviews-badge"
                    hidden={!item.badge}
                    class:list={[
                      'ml-2 min-w-5 rounded-full px-1.5 py-0.5 text-center text-xs font-semibold',
                      active === item.key
                        ? 'bg-white text-primary'
                        : 'bg-danger text-white',
                    ]}
                  >
                    {item.badge}
                  </span>
                ) : item.badge ? (
                  <span
                    class:list={[
                      'ml-2 min-w-5 rounded-full px-1.5 py-0.5 text-center text-xs font-semibold',
                      active === item.key
                        ? 'bg-white text-primary'
                        : 'bg-danger text-white',
                    ]}
                  >
                    {item.badge}
                  </span>
                ) : null}
              </a>
            ))
          }
        </nav>
      </aside>

      <!-- Main column -->
      <div class="flex min-w-0 flex-1 flex-col">
        <header
          class="flex h-16 items-center justify-between border-b-2 border-fill bg-white px-6"
        >
          <h1 class="text-lg font-semibold text-ink">{title}</h1>
          {
            email && (
              <div class="flex items-center gap-4 text-sm">
                <span class="text-subtle">{email}</span>
                <a
                  href="/admin/logout"
                  class="rounded-lg border-2 border-fill px-3 py-1 font-medium text-body hover:border-danger hover:text-danger"
                >
                  Выйти
                </a>
              </div>
            )
          }
        </header>
        <main class="min-w-0 flex-1 p-6">
          <slot />
        </main>
      </div>
    </div>

    <!-- Keep the reviews-queue badge in sync after in-page moderation: the
         ReviewsQueue island fires `reviews:moderated` with the fresh pending
         count in event.detail; we just render it (no fetch → no API-origin
         concerns here). -->
    <script>
      window.addEventListener('reviews:moderated', (e) => {
        const badge = document.getElementById('reviews-badge');
        if (!badge) return;
        const count = (e as CustomEvent<{ count: number }>).detail?.count ?? 0;
        badge.textContent = String(count);
        (badge as HTMLElement).hidden = !count;
      });
    </script>
  </body>
</html>
