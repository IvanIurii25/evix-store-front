---
// Static benefits strip (Phase 0): trust signals (COD, free pickup, courier,
// originals). Copy is localized and passed in from the page.
interface Props {
  items: { title: string; text: string }[];
}

const { items } = Astro.props;
---

<section class="mx-auto max-w-[1360px] px-5 pb-6 pt-14">
  <div class="grid grid-cols-2 gap-4 md:grid-cols-4">
    {
      items.map((b) => (
        <div class="rounded-2xl border-2 border-fill p-5">
          <span class="flex h-9 w-9 items-center justify-center rounded-full bg-badge-sale-bg text-badge-sale">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 20 20"
              fill="currentColor"
              class="h-5 w-5"
            >
              <path
                fill-rule="evenodd"
                d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0L3.3 9.7a1 1 0 0 1 1.4-1.4l3.8 3.8 6.8-6.8a1 1 0 0 1 1.4 0Z"
                clip-rule="evenodd"
              />
            </svg>
          </span>
          <h3 class="mt-3 font-semibold text-ink">{b.title}</h3>
          <p class="mt-1 text-sm text-subtle">{b.text}</p>
        </div>
      ))
    }
  </div>
</section>
