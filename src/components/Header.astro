---
// Storefront header «по мотивам ecom»: logo · Каталог button · big central
// live-search island · right icons. The Каталог button is a plain link to the
// /c hub (icon-only on narrow screens); a mega-menu island can enhance it later
// without taking the link away.
import SearchBox from '../islands/SearchBox.vue';
import CartCount from '../islands/CartCount.vue';
import {
  langFromPath,
  localePath,
  isLang,
  LANGS,
  type Alternate,
} from '../lib/i18n';
import { ui } from '../lib/i18n-strings';

interface Props {
  lang?: string;
  // Per-locale equivalents of the current page (from the page's alternates).
  // Absent → the switcher falls back to the other locale's home.
  alternates?: Alternate[];
}

const { lang: langProp, alternates = [] } = Astro.props;

// httpOnly access cookie is readable on the server → reflect auth state in SSR.
const loggedIn = Boolean(Astro.cookies.get('access')?.value);
// Prefer the page-provided locale; fall back to the URL (Header renders
// outside the [lang] route param).
const lang = isLang(langProp) ? langProp : langFromPath(Astro.url.pathname);
const t = ui(lang);

// Language switcher target for the given locale: the page's equivalent path if
// known (PDP dual-slug / home / search), else that locale's home (safe).
function switchHref(target: (typeof LANGS)[number]): string {
  const alt = alternates.find((a) => a.lang === target);
  return alt ? alt.path : localePath(target);
}
---

<header class="border-b border-fill">
  <div
    class="mx-auto flex h-20 max-w-[1360px] items-center gap-2 px-4 md:gap-4 md:px-5"
  >
    <a
      href={localePath(lang)}
      class="flex shrink-0 items-center gap-2 text-ink"
      aria-label="evix"
    >
      <svg class="h-9 w-9" viewBox="0 0 128 128" aria-hidden="true">
        <defs>
          <linearGradient id="evixHdr" x1="0.12" y1="0.9" x2="0.9" y2="0.12">
            <stop offset="0" stop-color="#436bef"></stop>
            <stop offset="1" stop-color="#06B6D4"></stop>
          </linearGradient>
        </defs>
        <path
          d="M64 16 L105.6 40 L105.6 88 L64 112 L22.4 88 L22.4 40 Z"
          fill="none"
          stroke="url(#evixHdr)"
          stroke-width="5"
          stroke-linejoin="round"></path>
        <g
          stroke="#436bef"
          stroke-width="11"
          stroke-linecap="round"
          fill="none"
        >
          <path d="M44 40 V88"></path>
          <path d="M44 40 H78"></path>
          <path d="M44 64 H70"></path>
          <path d="M44 88 H78"></path>
        </g>
        <circle cx="64" cy="16" r="6.5" fill="#06B6D4"></circle>
        <circle cx="105.6" cy="40" r="6.5" fill="#06B6D4"></circle>
        <circle cx="105.6" cy="88" r="6.5" fill="#436bef"></circle>
        <circle cx="64" cy="112" r="6.5" fill="#436bef"></circle>
        <circle cx="22.4" cy="88" r="6.5" fill="#436bef"></circle>
        <circle cx="22.4" cy="40" r="6.5" fill="#436bef"></circle>
        <circle cx="70" cy="64" r="5.5" fill="#06B6D4"></circle>
      </svg>
      <!-- Below 360px the row (mark + catalog + search + icons) cannot fit the
           wordmark too; the hexagon mark still identifies the brand. -->
      <span class="text-xl font-bold tracking-tight max-[359px]:hidden"
        >evix</span
      >
    </a>

    <a
      href={localePath(lang, 'c')}
      aria-label={t.catalog}
      class="flex h-12 shrink-0 items-center gap-2 rounded-[10px] bg-primary px-3 font-semibold text-white transition hover:bg-primary-hover md:px-5"
    >
      <svg
        class="h-5 w-5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round"></path>
      </svg>
      <span class="hidden md:inline">{t.catalog}</span>
    </a>

    <SearchBox client:idle lang={lang} />

    <nav class="flex shrink-0 items-center gap-4 text-ink md:gap-5">
      <a
        href={loggedIn ? localePath(lang, 'account') : localePath(lang, 'auth')}
        aria-label={loggedIn ? t.account : t.login}
        class="hover:text-primary"
      >
        <svg
          class="h-6 w-6"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <circle cx="12" cy="8" r="4"></circle><path
            d="M4 20a8 8 0 0 1 16 0"
            stroke-linecap="round"></path>
        </svg>
      </a>
      <a
        href={localePath(lang, 'cart')}
        aria-label={t.cart}
        class="relative hover:text-primary"
      >
        <svg
          class="h-6 w-6"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            d="M3 4h2l2.4 12.4a1 1 0 0 0 1 .8h9.2a1 1 0 0 0 1-.8L21 8H6"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
          <circle cx="9" cy="20" r="1"></circle><circle cx="18" cy="20" r="1"
          ></circle>
        </svg>
        <CartCount client:idle />
      </a>

      <div
        class="flex items-center gap-1 text-sm font-medium uppercase"
        aria-label={t.language}
      >
        {
          LANGS.map((l, i) => (
            <>
              {i > 0 && <span class="text-fill">|</span>}
              {l === lang ? (
                <span class="text-ink">{l}</span>
              ) : (
                <a
                  href={switchHref(l)}
                  hreflang={l}
                  class="text-subtle hover:text-primary"
                >
                  {l}
                </a>
              )}
            </>
          ))
        }
      </div>
    </nav>
  </div>
</header>
