---
interface Crumb {
  id: number;
  name: string;
  slug: string;
}

import type { Lang } from '../lib/i18n';
import { localePath } from '../lib/i18n';
import { listingStrings } from '../lib/i18n-strings';

interface Props {
  items: Crumb[];
  current?: string;
  lang: Lang;
}

const { items, current, lang } = Astro.props;
const t = listingStrings(lang);
---

<nav aria-label="breadcrumbs" class="text-sm text-subtle">
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
    <li>
      <a href={localePath(lang)} class="hover:text-primary"
        >{t.breadcrumbHome}</a
      >
    </li>
    {
      items.map((c) => (
        <li class="flex items-center gap-2">
          <span class="text-gray-300">/</span>
          <a href={localePath(lang, `c/${c.slug}`)} class="hover:text-primary">
            {c.name}
          </a>
        </li>
      ))
    }
    {
      current && (
        <li class="flex items-center gap-2">
          <span class="text-gray-300">/</span>
          <span class="text-ink">{current}</span>
        </li>
      )
    }
  </ol>
</nav>
