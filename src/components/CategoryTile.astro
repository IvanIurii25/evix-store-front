---
// Category tile (Phase 0): cover = first product's photo of the category
// (categories have no image field yet — Phase 2). Falls back to a brand tint.
interface Props {
  name: string;
  href: string;
  imageUrl?: string | null;
}

const { name, href, imageUrl } = Astro.props;
---

<a
  href={href}
  class="group relative flex aspect-[4/3] items-end overflow-hidden rounded-2xl border-2 border-fill bg-white"
>
  {
    imageUrl ? (
      <img
        src={imageUrl}
        alt={name}
        loading="lazy"
        class="absolute inset-0 h-full w-full object-contain p-5 transition duration-300 group-hover:scale-105"
      />
    ) : (
      <div class="absolute inset-0 bg-linear-to-br from-primary/10 to-primary/25" />
    )
  }
  <span
    class="relative z-10 w-full bg-linear-to-t from-black/65 via-black/25 to-transparent px-4 pb-3 pt-10 text-sm font-semibold text-white"
  >
    {name}
  </span>
</a>
