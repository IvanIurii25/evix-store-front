---
// Dark contrast footer «по мотивам ecom». Two columns: a "Shop" column with
// real internal links, and an "Information" column populated from the published,
// footer-visible content pages (manager-managed via the admin) — so adding or
// unpublishing an info/legal page is reflected here without a code change.
import { isLang, langFromPath, localePath, type Lang } from '../lib/i18n';
import { consentStrings, footerLabels } from '../lib/i18n-strings';
import { loadFooterPages } from '../api/site';
import SupportLink from './SupportLink.astro';

interface Props {
  lang?: string;
}

const { lang: langProp } = Astro.props;
const lang: Lang = isLang(langProp)
  ? langProp
  : langFromPath(Astro.url.pathname);
const labels = footerLabels(lang);
const consent = consentStrings(lang);
const pages = await loadFooterPages(lang);
---

<footer class="mt-16 bg-footer text-gray-300">
  <div class="mx-auto max-w-[1360px] px-5 py-12">
    <div class="grid grid-cols-1 gap-8 sm:grid-cols-3">
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wide text-gray-500">
          {labels.shopTitle}
        </h3>
        <ul class="mt-3 space-y-2 text-sm">
          <li>
            <a
              href={localePath(lang)}
              class="text-gray-300 transition hover:text-primary"
            >
              {labels.catalog}
            </a>
          </li>
          <li>
            <SupportLink
              label={labels.support}
              payload="site"
              class="text-gray-300 transition hover:text-primary"
            />
          </li>
        </ul>
      </div>

      {
        pages.length > 0 && (
          <div>
            <h3 class="text-xs font-semibold uppercase tracking-wide text-gray-500">
              {labels.infoTitle}
            </h3>
            <ul class="mt-3 space-y-2 text-sm">
              {pages.map((p) => (
                <li>
                  <a
                    href={localePath(lang, `info/${p.slug}`)}
                    class="text-gray-300 transition hover:text-primary"
                  >
                    {p.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
    <div
      class="mt-10 flex flex-wrap items-center justify-between gap-3 border-t border-white/10 pt-6 text-sm text-gray-500"
    >
      <span>© 2026 evix — MDL.</span>
      <button
        type="button"
        data-cookie-settings
        class="text-gray-400 transition hover:text-primary"
      >
        {consent.settings}
      </button>
    </div>
  </div>
</footer>

<script>
  // Reopen the cookie consent banner (right to withdraw/change consent).
  document
    .querySelector('[data-cookie-settings]')
    ?.addEventListener('click', () => {
      window.dispatchEvent(new Event('evix:open-consent'));
    });
</script>
