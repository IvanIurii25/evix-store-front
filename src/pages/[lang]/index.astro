---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import CategoryTile from '../../components/CategoryTile.astro';
import ProductRail from '../../components/ProductRail.astro';
import Benefits from '../../components/Benefits.astro';
import {
  loadCategoryTree,
  listProducts,
  listAllProducts,
} from '../../api/catalog';
import { isLang, localePath, hreflangAlternates } from '../../lib/i18n';
import { homeStrings, catalogStrings } from '../../lib/i18n-strings';
import { organizationJsonLd, websiteJsonLd } from '../../lib/seo';

export const prerender = false;

const { lang } = Astro.params;
if (!isLang(lang)) return Astro.rewrite('/404');

const t = homeStrings(lang);

// Every root category that has products powers the tiles — capping the list hid
// whole sections of the store (the full tree lives on the /c hub).
const categories = await loadCategoryTree(lang);
const topCats = categories.filter((c) => c.product_count > 0);

// Fetch in parallel: a first-page listing per top category (for tile covers)
// plus the three store-wide rails (featured + newest + on-sale). Categories that
// carry their own cover skip the listing — its result would be discarded below.
const [covers, featured, newest, deals] = await Promise.all([
  Promise.all(
    topCats.map((c) =>
      c.cover_image_url
        ? Promise.resolve({ cat: c, image: null })
        : listProducts(c.slug, lang, { sort: 'newest' })
            .then((r) => ({ cat: c, image: r.data[0]?.main_image_url ?? null }))
            .catch(() => ({ cat: c, image: null })),
    ),
  ),
  listAllProducts(lang, { featured: true })
    .then((r) => r.data)
    .catch(() => []),
  listAllProducts(lang, { sort: 'newest' })
    .then((r) => r.data)
    .catch(() => []),
  listAllProducts(lang, { onSale: true })
    .then((r) => r.data)
    .catch(() => []),
]);

const tiles = covers.map((c) => ({
  name: c.cat.name,
  slug: c.cat.slug,
  // Prefer the category's own cover; fall back to its first product's photo.
  imageUrl: c.cat.cover_image_url ?? c.image,
}));

// Hero image: the newest product photo across the store.
const heroImage = newest[0]?.main_image_url ?? null;

const alternates = hreflangAlternates((l) => localePath(l));

const origin = (Astro.site ?? new URL('http://localhost:4321')).href;
const jsonLd = [organizationJsonLd(origin), websiteJsonLd(origin, lang)];
---

<Layout
  lang={lang}
  canonical={localePath(lang)}
  alternates={alternates}
  jsonLd={jsonLd}
>
  <Hero
    title={t.heroTitle}
    subtitle={t.heroSubtitle}
    ctaLabel={t.heroCta}
    ctaHref="#categories"
    imageUrl={heroImage}
  />

  {
    tiles.length > 0 && (
      <section id="categories" class="mx-auto max-w-[1360px] px-5 pt-14">
        <div class="flex flex-wrap items-baseline justify-between gap-3">
          <h2 class="text-2xl font-bold text-ink">{t.categoriesTitle}</h2>
          <a
            href={localePath(lang, 'c')}
            class="font-semibold text-primary hover:underline"
          >
            {catalogStrings(lang).allCategories} →
          </a>
        </div>
        <div class="mt-6 grid grid-cols-2 gap-4 md:grid-cols-4">
          {tiles.map((tile) => (
            <CategoryTile
              name={tile.name}
              href={localePath(lang, `c/${tile.slug}`)}
              imageUrl={tile.imageUrl}
            />
          ))}
        </div>
      </section>
    )
  }

  {
    featured.length > 0 && (
      <ProductRail
        title={t.popularTitle}
        products={featured.slice(0, 10)}
        lang={lang}
      />
    )
  }

  {
    newest.length > 0 && (
      <ProductRail
        title={t.newestTitle}
        products={newest.slice(0, 10)}
        lang={lang}
      />
    )
  }

  {
    deals.length > 0 && (
      <ProductRail
        title={t.dealsTitle}
        products={deals.slice(0, 10)}
        lang={lang}
      />
    )
  }

  <Benefits items={t.benefits} />

  {
    categories.length === 0 && (
      <p class="mx-auto max-w-[1360px] px-5 py-10 text-subtle">
        Каталог недоступен — проверь, что бэкенд запущен ({lang}).
      </p>
    )
  }
</Layout>
