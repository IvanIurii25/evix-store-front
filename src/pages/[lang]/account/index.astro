---
import Layout from '../../../layouts/Layout.astro';
import LogoutButton from '../../../islands/LogoutButton.vue';
import Addresses from '../../../islands/Addresses.vue';
import OrderHistory from '../../../islands/OrderHistory.vue';
import DeleteAccount from '../../../islands/DeleteAccount.vue';
import { meWithToken } from '../../../api/auth';
import { isLang, localePath } from '../../../lib/i18n';
import { accountStrings } from '../../../lib/i18n-strings';

export const prerender = false;

const { lang } = Astro.params;
if (!isLang(lang)) return Astro.rewrite('/404');

// SSR-guard: the access cookie is httpOnly but readable server-side.
const loginUrl = localePath(
  lang,
  `auth?next=${encodeURIComponent(localePath(lang, 'account'))}`,
);
const access = Astro.cookies.get('access')?.value;
if (!access) return Astro.redirect(loginUrl);

const user = await meWithToken(access);
if (!user) return Astro.redirect(loginUrl);

const t = accountStrings(lang);
---

<Layout title={t.pageTitle} lang={lang}>
  <div class="mx-auto max-w-[1360px] px-5 py-10">
    <div class="flex items-center justify-between">
      <h1 class="text-2xl font-bold text-ink">{t.pageTitle}</h1>
      <LogoutButton client:idle lang={lang} />
    </div>

    <div class="mt-8 grid gap-8 lg:grid-cols-2">
      <section>
        <h2 class="font-semibold text-ink">{t.profile}</h2>
        <dl class="mt-3 space-y-2 rounded-2xl border-2 border-fill p-6 text-sm">
          <div class="flex justify-between gap-4">
            <dt class="text-subtle">Email</dt>
            <dd class="text-ink">{user.email}</dd>
          </div>
          {
            user.phone && (
              <div class="flex justify-between gap-4">
                <dt class="text-subtle">{t.phone}</dt>
                <dd class="text-ink">{user.phone}</dd>
              </div>
            )
          }
        </dl>

        <h2 class="mt-8 font-semibold text-ink">{t.deliveryAddresses}</h2>
        <div class="mt-3">
          <Addresses client:visible lang={lang} />
        </div>

        <div class="mt-8">
          <DeleteAccount client:visible lang={lang} />
        </div>
      </section>

      <section>
        <h2 class="font-semibold text-ink">{t.orderHistory}</h2>
        <div class="mt-3">
          <OrderHistory client:visible lang={lang} />
        </div>
      </section>
    </div>
  </div>
</Layout>
