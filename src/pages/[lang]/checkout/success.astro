---
import Layout from '../../../layouts/Layout.astro';
import { getOrder } from '../../../api/checkout';
import { price } from '../../../lib/format';
import { isLang, localePath } from '../../../lib/i18n';
import { checkoutStrings } from '../../../lib/i18n-strings';

export const prerender = false;

const { lang } = Astro.params;
if (!isLang(lang)) return new Response('Not found', { status: 404 });
const t = checkoutStrings(lang);

const url = new URL(Astro.request.url);
const number = url.searchParams.get('number') ?? '';
// The contact email comes from a short-lived cookie set by the checkout form,
// not the URL, so it is never left in browser history / logs (LP195/2024).
const email = Astro.cookies.get('order_email')?.value ?? '';
const order = number && email ? await getOrder(number, email) : null;
const loggedIn = Boolean(Astro.cookies.get('access')?.value);
---

<Layout title={t.successTitle} lang={lang}>
  <div class="mx-auto max-w-2xl px-5 py-12">
    {
      order ? (
        <div>
          <div class="rounded-2xl border-2 border-fill p-8 text-center">
            <div class="text-4xl text-price">✓</div>
            <h1 class="mt-3 text-2xl font-bold text-ink">
              {t.orderPlacedPre} {order.number} {t.orderPlacedPost}
            </h1>
            <p class="mt-2 text-subtle">
              {t.willContactPre} {order.phone} {t.willContactPost}
            </p>
          </div>

          <div class="mt-6 rounded-2xl border-2 border-fill p-6">
            <div class="flex justify-between text-sm">
              <span class="text-subtle">{t.payment}</span>
              <span class="text-ink">{t.paymentCod}</span>
            </div>
            <div class="mt-1 flex justify-between text-sm">
              <span class="text-subtle">{t.delivery}</span>
              <span class="text-ink">
                {order.delivery_type === 'pickup'
                  ? t.pickupShort
                  : t.courierShort}
              </span>
            </div>
            {order.delivery_name && (
              <div class="mt-1 flex justify-between gap-4 text-sm">
                <span class="text-subtle">{t.address}</span>
                <span class="text-right text-ink">
                  {order.delivery_name}, {order.delivery_city},{' '}
                  {order.delivery_street}
                  {order.delivery_zip ? `, ${order.delivery_zip}` : ''}
                </span>
              </div>
            )}
            <ul class="mt-4 divide-y divide-fill">
              {(order.items ?? []).map((it) => (
                <li class="flex justify-between gap-4 py-2 text-sm">
                  <span class="text-body">
                    {it.name_snapshot} × {it.qty}
                  </span>
                  <span class="whitespace-nowrap font-medium text-ink">
                    {price(it.price_snapshot)}
                  </span>
                </li>
              ))}
            </ul>
            {Number(order.discount_total) > 0 && (
              <div class="mt-3 flex justify-between border-t border-fill pt-3 text-sm text-price">
                <span>{t.discount}</span>
                <span>−{price(order.discount_total)}</span>
              </div>
            )}
            <div
              class:list={[
                'flex justify-between border-t border-fill pt-3',
                Number(order.discount_total) > 0 ? 'mt-3' : 'mt-4',
              ]}
            >
              <span class="font-semibold text-ink">{t.total}</span>
              <span class="text-xl font-semibold text-price">
                {price(order.total)}
              </span>
            </div>
          </div>

          <div class="mt-6 flex flex-wrap gap-3">
            <a
              href={localePath(lang)}
              class="rounded-xl bg-primary px-6 py-2.5 font-medium text-white transition hover:bg-primary-hover"
            >
              {t.toCatalog}
            </a>
            {!loggedIn && (
              <a
                href={localePath(lang, 'auth')}
                class="rounded-xl border-2 border-fill px-6 py-2.5 font-medium text-body transition hover:border-primary hover:text-primary"
              >
                {t.createAccount}
              </a>
            )}
          </div>
        </div>
      ) : (
        <p class="text-subtle">
          {t.notFoundPre}{' '}
          <a href={localePath(lang)} class="text-primary hover:underline">
            {t.backToCatalog}
          </a>
          .
        </p>
      )
    }
  </div>
</Layout>
