---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ProductGallery from '../../../islands/ProductGallery.vue';
import AddToCart from '../../../islands/AddToCart.vue';
import { getProduct } from '../../../api/catalog';
import { price } from '../../../lib/format';
import {
  isLang,
  localePath,
  DEFAULT_LOCALE,
  type Alternate,
} from '../../../lib/i18n';
import { productJsonLd, breadcrumbJsonLd } from '../../../lib/seo';

export const prerender = false;

const { lang, slug } = Astro.params;
if (!isLang(lang)) return new Response('Not found', { status: 404 });

const product = slug ? await getProduct(slug, lang) : null;

if (!product) return new Response('Product not found', { status: 404 });

const media = product.media ?? [];

// Per-locale slugs come from the backend (slugs[]) → real hreflang equivalents.
const canonical = localePath(lang, `p/${product.slug}`);
const alternates: Alternate[] = [];
for (const s of product.slugs ?? []) {
  if (isLang(s.lang)) {
    alternates.push({ lang: s.lang, path: localePath(s.lang, `p/${s.slug}`) });
  }
}
const defaultSlug = (product.slugs ?? []).find(
  (s) => s.lang === DEFAULT_LOCALE,
)?.slug;
if (defaultSlug) {
  alternates.push({
    lang: 'x-default',
    path: localePath(DEFAULT_LOCALE, `p/${defaultSlug}`),
  });
}

const origin = (Astro.site ?? new URL('http://localhost:4321')).href;
const jsonLd = [
  productJsonLd(origin, canonical, product),
  breadcrumbJsonLd(origin, lang, product.breadcrumbs ?? [], {
    name: product.name,
    path: canonical,
  }),
];
---

<Layout
  title={product.seo_title ?? product.name}
  description={product.seo_description ?? ''}
  lang={lang}
  canonical={canonical}
  alternates={alternates}
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-[1360px] px-5 py-6">
    <Breadcrumbs
      items={product.breadcrumbs ?? []}
      current={product.name}
      lang={lang}
    />

    <div class="mt-6 flex flex-col gap-10 lg:flex-row">
      <!-- Gallery (island: switch main image via thumbnails) -->
      <div class="lg:w-1/2">
        <ProductGallery client:visible images={media} alt={product.name} />
      </div>

      <!-- Info -->
      <div class="lg:w-[525px]">
        <h1 class="text-2xl font-bold text-ink">{product.name}</h1>
        <div class="mt-1 text-sm text-subtle">Код: {product.code}</div>

        <div class="mt-5 flex items-baseline gap-3">
          <span class="text-3xl font-semibold text-price"
            >{price(product.price)}</span
          >
          {
            product.old_price && (
              <span class="text-lg text-subtle line-through">
                {price(product.old_price)}
              </span>
            )
          }
        </div>
        <div
          class={`mt-2 text-sm ${product.in_stock ? 'text-price' : 'text-subtle'}`}
        >
          {product.in_stock ? 'В наличии' : 'Нет в наличии'}
        </div>

        <div class="mt-6">
          <AddToCart
            client:visible
            productId={product.id}
            inStock={product.in_stock}
          />
        </div>

        {
          product.description && (
            <section class="mt-8">
              <h2 class="font-semibold text-ink">Описание</h2>
              <p class="mt-2 text-body">{product.description}</p>
            </section>
          )
        }

        {
          product.attributes && product.attributes.length > 0 && (
            <section class="mt-8">
              <h2 class="font-semibold text-ink">Характеристики</h2>
              <dl class="mt-2 divide-y divide-fill">
                {product.attributes.map((a) => (
                  <div class="flex justify-between gap-4 py-2 text-sm">
                    <dt class="text-subtle">{a.name}</dt>
                    <dd class="text-right text-ink">
                      {(a.values ?? []).join(', ')}
                    </dd>
                  </div>
                ))}
              </dl>
            </section>
          )
        }
      </div>
    </div>
  </div>
</Layout>
