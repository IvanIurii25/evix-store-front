---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ProductGallery from '../../../islands/ProductGallery.vue';
import AddToCart from '../../../islands/AddToCart.vue';
import QuickBuy from '../../../islands/QuickBuy.vue';
import RestockNotify from '../../../islands/RestockNotify.vue';
import ProductReviews from '../../../islands/ProductReviews.vue';
import ShareButtons from '../../../islands/ShareButtons.vue';
import ProductRail from '../../../components/ProductRail.astro';
import RecentlyViewed from '../../../islands/RecentlyViewed.vue';
import SupportLink from '../../../components/SupportLink.astro';
import {
  footerLabels,
  ui,
  pdpStrings,
  reviewStrings,
} from '../../../lib/i18n-strings';
import { productPayload } from '../../../lib/support';
import { getProduct, getRelatedProducts } from '../../../api/catalog';
import { optimizeDescriptionHtml } from '../../../lib/description';
import {
  price,
  discountPercent,
  personCount,
  reviewCount,
  installmentMonthly,
  INSTALLMENT_TERM,
  INSTALLMENT_THRESHOLD,
} from '../../../lib/format';
import {
  isLang,
  localePath,
  DEFAULT_LOCALE,
  type Alternate,
} from '../../../lib/i18n';
import { productJsonLd, breadcrumbJsonLd } from '../../../lib/seo';

export const prerender = false;

const { lang, slug } = Astro.params;
if (!isLang(lang)) return new Response('Not found', { status: 404 });

const product = slug ? await getProduct(slug, lang) : null;

if (!product) return new Response('Product not found', { status: 404 });

const t = ui(lang);
const tp = pdpStrings(lang);
const tr = reviewStrings(lang);

// Rating summary near the title (SSR, no extra request): only when there is at
// least one approved review. `ratingAvg` feeds both the star row and JSON-LD.
const ratingCount = product.rating_count ?? 0;
const ratingAvg = product.rating_avg ?? null;
const showRating = ratingCount > 0 && ratingAvg != null;
const ratingStars = ratingAvg != null ? Math.round(ratingAvg) : 0;

// SSR auth (mirrors the /account SSR-guard): the httpOnly `access` cookie is
// readable server-side. Passed to ProductReviews so guests never hit
// /reviews/mine (which would 401 and log an error in the browser console).
const isLoggedIn = Boolean(Astro.cookies.get('access')?.value);

const related = await getRelatedProducts(product.slug, lang, 8);

const media = product.media ?? [];

// Product details (feature B): description + specs render full-width below the
// hero, both shown at once (no tabs). optimizeDescriptionHtml is pure string
// work (sanitize + WebP <picture>), safe to run server-side here.
const attributes = product.attributes ?? [];
const descriptionHtml = optimizeDescriptionHtml(product.description);
const hasDescription = Boolean(descriptionHtml);
const hasAttributes = attributes.length > 0;

// Discount badge (-N%): shown only when old_price is set and > current price.
const salePercent = discountPercent(product.old_price, product.price);

// Honest social-proof (feature A3): the backend returns the REAL number of
// distinct live carts holding this product. Show it only above a threshold so
// low-traffic pages stay silent — never a fabricated number.
const IN_CART_THRESHOLD = 3;
const inCartCount = product.in_cart_count ?? 0;
const showInCart = inCartCount >= IN_CART_THRESHOLD;

// Per-locale slugs come from the backend (slugs[]) → real hreflang equivalents.
const canonical = localePath(lang, `p/${product.slug}`);
const alternates: Alternate[] = [];
for (const s of product.slugs ?? []) {
  if (isLang(s.lang)) {
    alternates.push({ lang: s.lang, path: localePath(s.lang, `p/${s.slug}`) });
  }
}
const defaultSlug = (product.slugs ?? []).find(
  (s) => s.lang === DEFAULT_LOCALE,
)?.slug;
if (defaultSlug) {
  alternates.push({
    lang: 'x-default',
    path: localePath(DEFAULT_LOCALE, `p/${defaultSlug}`),
  });
}

const origin = (Astro.site ?? new URL('http://localhost:4321')).href;
const jsonLd = [
  productJsonLd(origin, canonical, product),
  breadcrumbJsonLd(origin, lang, product.breadcrumbs ?? [], {
    name: product.name,
    path: canonical,
  }),
];

// Absolute canonical URL for social sharing (same source as <link canonical>).
const shareUrl = new URL(canonical, Astro.site ?? origin).href;

// Indicative installment line (NOT a real BNPL — estimated trigger, gated by a
// price threshold so cheap items stay silent).
const installment = installmentMonthly(product.price, INSTALLMENT_TERM);
const showInstallment = Number(product.price) >= INSTALLMENT_THRESHOLD;
---

<Layout
  title={product.seo_title ?? product.name}
  description={product.seo_description ?? ''}
  lang={lang}
  canonical={canonical}
  alternates={alternates}
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-[1360px] px-5 py-6">
    <Breadcrumbs
      items={product.breadcrumbs ?? []}
      current={product.name}
      lang={lang}
    />

    <div class="mt-6 flex flex-col gap-10 lg:flex-row lg:items-start">
      <!-- Gallery (island: switch main image via thumbnails) -->
      <div class="lg:flex-1 lg:min-w-0">
        <ProductGallery client:visible images={media} alt={product.name} />
      </div>

      <!-- Info (sticky within the hero row while scanning the gallery) -->
      <div class="lg:sticky lg:top-6 lg:w-[380px] lg:shrink-0">
        <h1 class="text-2xl font-bold text-ink">{product.name}</h1>
        <div class="mt-1 text-sm text-subtle">{tp.code} {product.code}</div>

        {
          showRating && (
            <a
              href="#reviews"
              class="mt-2 inline-flex items-center gap-2 text-sm text-subtle transition hover:text-primary"
            >
              <span class="text-base text-amber-400" aria-hidden="true">
                {[1, 2, 3, 4, 5].map((s) => (
                  <span class={s <= ratingStars ? '' : 'text-fill'}>★</span>
                ))}
              </span>
              <span class="font-semibold text-ink">
                {ratingAvg!.toFixed(1)}
              </span>
              <span class="underline">({reviewCount(ratingCount, lang)})</span>
            </a>
          )
        }

        <div class="mt-5 flex items-baseline gap-3">
          <span class="text-3xl font-semibold text-price"
            >{price(product.price)}</span
          >
          {
            product.old_price && (
              <span class="text-lg text-subtle line-through">
                {price(product.old_price)}
              </span>
            )
          }
          {
            salePercent > 0 && (
              <span class="rounded-lg bg-badge-sale-bg px-2 py-1 text-sm font-semibold text-badge-sale">
                -{salePercent}%
              </span>
            )
          }
        </div>
        <div
          class={`mt-2 text-sm ${product.in_stock ? 'text-price' : 'text-subtle'}`}
        >
          {product.in_stock ? t.inStock : t.outOfStock}
        </div>

        {
          showInCart && (
            <div class="mt-2 text-sm font-medium text-badge-sale">
              {tp.inCartPrefix} {personCount(inCartCount, lang)}
            </div>
          )
        }

        {
          showInstallment && (
            <div class="mt-4 flex items-center gap-2 rounded-lg bg-fill/40 px-3 py-2 text-sm text-ink">
              <svg
                viewBox="0 0 24 24"
                width="18"
                height="18"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
                class="text-subtle"
              >
                <rect x="2" y="5" width="20" height="14" rx="2" />
                <path d="M2 10h20" />
              </svg>
              <span>
                {tp.installmentPrefix}
                {installment.toLocaleString('ro-MD')} {tp.installmentSuffix}
              </span>
              <span class="text-xs text-subtle">· {tp.installmentNote}</span>
            </div>
          )
        }

        <div class="mt-6">
          {
            product.in_stock ? (
              <div class="space-y-3">
                <AddToCart
                  client:visible
                  productId={product.id}
                  inStock={product.in_stock}
                  lang={lang}
                />
                <QuickBuy client:visible productId={product.id} lang={lang} />
              </div>
            ) : (
              <RestockNotify
                client:visible
                productId={product.id}
                lang={lang}
                productPath={canonical}
              />
            )
          }
        </div>

        <SupportLink
          label={footerLabels(lang).support}
          payload={productPayload(product.id)}
          class="mt-3 inline-block text-sm text-subtle underline transition hover:text-primary"
        />

        <ShareButtons
          client:visible
          url={shareUrl}
          name={product.name}
          lang={lang}
        />

        {
          hasAttributes && (
            <div class="mt-8">
              <h2 class="text-sm font-semibold uppercase tracking-wide text-subtle">
                {tp.tabAttributes}
              </h2>
              <dl class="mt-3 divide-y divide-fill rounded-2xl border-2 border-fill px-4 py-1">
                {attributes.map((a) => (
                  <div class="flex justify-between gap-4 py-2 text-sm">
                    <dt class="text-subtle">{a.name}</dt>
                    <dd class="text-right text-ink">
                      {(a.values ?? []).join(', ')}
                    </dd>
                  </div>
                ))}
              </dl>
            </div>
          )
        }
      </div>
    </div>

    {
      hasDescription && (
        <section class="mx-auto mt-12 max-w-[820px]">
          <h2 class="text-xl font-semibold text-ink">{tp.tabDescription}</h2>
          <div
            class="prod-description mt-4 text-body"
            set:html={descriptionHtml}
          />
        </section>
      )
    }

    <section id="reviews" class="mx-auto mt-14 max-w-[980px] scroll-mt-6">
      <h2 class="text-xl font-semibold text-ink">
        {tr.sectionTitle}{ratingCount > 0 ? ` (${ratingCount})` : ''}
      </h2>
      <div class="mt-6">
        <ProductReviews
          client:visible
          productId={product.id}
          slug={product.slug}
          lang={lang}
          productPath={canonical}
          isLoggedIn={isLoggedIn}
          initialAggregate={{
            average: ratingAvg,
            count: ratingCount,
            distribution: { '5': 0, '4': 0, '3': 0, '2': 0, '1': 0 },
          }}
        />
      </div>
    </section>
  </div>

  {
    related.length > 0 && (
      <ProductRail title={tp.relatedTitle} products={related} lang={lang} />
    )
  }

  <RecentlyViewed
    client:load
    lang={lang}
    current={{
      slug: product.slug,
      name: product.name,
      image: media[0]?.url ?? null,
      price: product.price,
    }}
  />
</Layout>

<style>
  /* set:html'd product description: keep imported images responsive + readable
     flow. Astro scopes .prod-description; :global() reaches the injected HTML. */
  .prod-description :global(img),
  .prod-description :global(picture) {
    max-width: 100%;
    height: auto;
    margin: 0.75rem auto;
    display: block;
  }
  .prod-description :global(p) {
    line-height: 1.7;
    margin-bottom: 0.75rem;
  }
  .prod-description :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
  }
</style>
