---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CatalogControls from '../../../islands/CatalogControls.vue';
import { getCategory, listProducts, getFacets } from '../../../api/catalog';
import {
  isLang,
  localePath,
  DEFAULT_LOCALE,
  type Alternate,
} from '../../../lib/i18n';
import { breadcrumbJsonLd } from '../../../lib/seo';

// On-demand SSR (SSG per-category is a later optimization, plan §2). The island
// is server-rendered too, so the first grid is in HTML, then it hydrates (F2).
export const prerender = false;

const { lang, slug } = Astro.params;
if (!isLang(lang)) return new Response('Not found', { status: 404 });

const parts = (slug ?? '').split('/').filter(Boolean);
const catSlug = parts[parts.length - 1];

if (!catSlug) return Astro.redirect(localePath(lang));

let category;
let listing;
let facets;
try {
  category = await getCategory(catSlug, lang);
  [listing, facets] = await Promise.all([
    listProducts(catSlug, lang),
    getFacets(catSlug, lang),
  ]);
} catch {
  return new Response('Category not found', { status: 404 });
}

// Categories resolve by leaf slug (the ancestor path in the URL is decorative),
// so the canonical is the leaf form — matching how nav/breadcrumbs link here.
const canonical = localePath(lang, `c/${catSlug}`);

// Per-locale slugs from the backend → real hreflang equivalents + switcher.
const alternates: Alternate[] = [];
for (const s of category.slugs ?? []) {
  if (isLang(s.lang)) {
    alternates.push({ lang: s.lang, path: localePath(s.lang, `c/${s.slug}`) });
  }
}
const defaultSlug = (category.slugs ?? []).find(
  (s) => s.lang === DEFAULT_LOCALE,
)?.slug;
if (defaultSlug) {
  alternates.push({
    lang: 'x-default',
    path: localePath(DEFAULT_LOCALE, `c/${defaultSlug}`),
  });
}

// Category breadcrumbs already include the category itself as the last item,
// so drop it and pass the category as `current` (no duplicate trail entry).
const ancestors = (category.breadcrumbs ?? []).slice(0, -1);
const origin = (Astro.site ?? new URL('http://localhost:4321')).href;
const jsonLd = [
  breadcrumbJsonLd(origin, lang, ancestors, {
    name: category.name,
    path: canonical,
  }),
];
---

<Layout
  title={category.seo_title ?? category.name}
  description={category.seo_description ?? ''}
  lang={lang}
  canonical={canonical}
  alternates={alternates}
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-[1360px] px-5 py-6">
    <Breadcrumbs
      items={category.breadcrumbs ?? []}
      current={category.name}
      lang={lang}
    />
    <h1 class="mt-4 text-2xl font-bold text-ink">{category.name}</h1>

    {
      category.children && category.children.length > 0 && (
        <nav class="mt-4 flex flex-wrap gap-2">
          {category.children.map((c) => (
            <a
              href={localePath(lang, `c/${c.slug}`)}
              class="rounded-full border-2 border-fill px-4 py-1.5 text-sm text-body transition hover:border-primary hover:text-primary"
            >
              {c.name}
            </a>
          ))}
        </nav>
      )
    }

    <div class="mt-6">
      <CatalogControls
        client:load
        categorySlug={catSlug}
        lang={lang}
        initialProducts={listing.data}
        initialCursor={listing.next_cursor ?? null}
        facets={facets}
      />
    </div>
  </div>
</Layout>
