---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getProduct } from '../../api/catalog';
import { price } from '../../lib/format';
import { DEFAULT_LANG } from '../../config/env';

export const prerender = false;

const { slug } = Astro.params;
const lang = DEFAULT_LANG;
const product = slug ? await getProduct(slug, lang) : null;

if (!product) return new Response('Product not found', { status: 404 });

const media = product.media ?? [];
const mainImage = media[0];
---

<Layout
  title={product.seo_title ?? product.name}
  description={product.seo_description ?? ''}
>
  <div class="mx-auto max-w-[1360px] px-5 py-6">
    <Breadcrumbs items={product.breadcrumbs ?? []} current={product.name} />

    <div class="mt-6 flex flex-col gap-10 lg:flex-row">
      <!-- Gallery -->
      <div class="lg:w-1/2">
        <div
          class="flex aspect-square items-center justify-center rounded-2xl border-2 border-fill bg-white p-6"
        >
          {
            mainImage ? (
              <img
                src={mainImage.url}
                alt={product.name}
                class="max-h-full object-contain"
              />
            ) : (
              <span class="text-subtle">нет фото</span>
            )
          }
        </div>
        {
          media.length > 1 && (
            <div class="mt-4 flex gap-3">
              {media.map((m) => (
                <img
                  src={m.url}
                  alt=""
                  class="h-20 w-20 rounded-lg border-2 border-fill object-contain p-1"
                />
              ))}
            </div>
          )
        }
      </div>

      <!-- Info -->
      <div class="lg:w-[525px]">
        <h1 class="text-2xl font-bold text-ink">{product.name}</h1>
        <div class="mt-1 text-sm text-subtle">Код: {product.code}</div>

        <div class="mt-5 flex items-baseline gap-3">
          <span class="text-3xl font-semibold text-price"
            >{price(product.price)}</span
          >
          {
            product.old_price && (
              <span class="text-lg text-subtle line-through">
                {price(product.old_price)}
              </span>
            )
          }
        </div>
        <div
          class={`mt-2 text-sm ${product.in_stock ? 'text-price' : 'text-subtle'}`}
        >
          {product.in_stock ? 'В наличии' : 'Нет в наличии'}
        </div>

        <div class="mt-6">
          <button
            class="h-12 w-full rounded-xl bg-primary font-medium text-white transition hover:bg-primary-hover"
          >
            В корзину
          </button>
        </div>

        {
          product.description && (
            <section class="mt-8">
              <h2 class="font-semibold text-ink">Описание</h2>
              <p class="mt-2 text-body">{product.description}</p>
            </section>
          )
        }

        {
          product.attributes && product.attributes.length > 0 && (
            <section class="mt-8">
              <h2 class="font-semibold text-ink">Характеристики</h2>
              <dl class="mt-2 divide-y divide-fill">
                {product.attributes.map((a) => (
                  <div class="flex justify-between gap-4 py-2 text-sm">
                    <dt class="text-subtle">{a.name}</dt>
                    <dd class="text-right text-ink">
                      {(a.values ?? []).join(', ')}
                    </dd>
                  </div>
                ))}
              </dl>
            </section>
          )
        }
      </div>
    </div>
  </div>
</Layout>
