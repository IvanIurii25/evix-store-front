---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import OrdersTable from '../../../islands/admin/OrdersTable.vue';
import { requireStaff } from '../../../lib/admin-guard';

export const prerender = false;

const guard = await requireStaff(Astro.cookies, Astro.url.pathname);
if (!guard.ok) return Astro.redirect(guard.redirect);
---

<AdminLayout title="Заказы" email={guard.user.email} active="orders">
  <OrdersTable client:load />
</AdminLayout>
