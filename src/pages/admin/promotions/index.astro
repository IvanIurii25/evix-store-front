---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Promotions from '../../../islands/admin/Promotions.vue';
import { requireStaff } from '../../../lib/admin-guard';

export const prerender = false;

const guard = await requireStaff(Astro.cookies, Astro.url.pathname);
if (!guard.ok) return Astro.redirect(guard.redirect);
---

<AdminLayout title="Акции" email={guard.user.email} active="promotions">
  <Promotions client:load />
</AdminLayout>
