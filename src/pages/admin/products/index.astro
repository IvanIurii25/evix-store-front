---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import ProductsTable from '../../../islands/admin/ProductsTable.vue';
import { requireStaff } from '../../../lib/admin-guard';

export const prerender = false;

const guard = await requireStaff(Astro.cookies, Astro.url.pathname);
if (!guard.ok) return Astro.redirect(guard.redirect);
---

<AdminLayout title="Товары" email={guard.user.email} active="products">
  <ProductsTable client:load />
</AdminLayout>
