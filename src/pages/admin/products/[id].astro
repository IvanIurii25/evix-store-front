---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import ProductEditor from '../../../islands/admin/ProductEditor.vue';
import { requireStaff } from '../../../lib/admin-guard';

export const prerender = false;

const guard = await requireStaff(Astro.cookies, Astro.url.pathname);
if (!guard.ok) return Astro.redirect(guard.redirect);

const { id } = Astro.params;
if (!id || Number.isNaN(Number(id))) {
  return new Response('Not found', { status: 404 });
}
---

<AdminLayout
  title="Редактирование товара"
  email={guard.user.email}
  active="products"
>
  <ProductEditor client:load productId={Number(id)} />
</AdminLayout>
