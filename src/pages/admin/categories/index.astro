---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import CategoryTree from '../../../islands/admin/CategoryTree.vue';
import { requireStaff } from '../../../lib/admin-guard';

export const prerender = false;

const guard = await requireStaff(Astro.cookies, Astro.url.pathname);
if (!guard.ok) return Astro.redirect(guard.redirect);
---

<AdminLayout title="Категории" email={guard.user.email} active="categories">
  <CategoryTree client:load />
</AdminLayout>
