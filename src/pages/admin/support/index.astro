---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import SupportInbox from '../../../islands/admin/SupportInbox.vue';
import { requireStaff } from '../../../lib/admin-guard';

export const prerender = false;

const guard = await requireStaff(Astro.cookies, Astro.url.pathname);
if (!guard.ok) return Astro.redirect(guard.redirect);
---

<AdminLayout title="Поддержка" email={guard.user.email} active="support">
  <SupportInbox client:load />
</AdminLayout>
