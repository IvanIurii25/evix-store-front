---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Promos from '../../../islands/admin/Promos.vue';
import { requireStaff } from '../../../lib/admin-guard';

export const prerender = false;

const guard = await requireStaff(Astro.cookies, Astro.url.pathname);
if (!guard.ok) return Astro.redirect(guard.redirect);
---

<AdminLayout title="Промокоды" email={guard.user.email} active="promo">
  <Promos client:load />
</AdminLayout>
