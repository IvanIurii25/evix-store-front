---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import CustomersTable from '../../../islands/admin/CustomersTable.vue';
import { requireStaff } from '../../../lib/admin-guard';

export const prerender = false;

const guard = await requireStaff(Astro.cookies, Astro.url.pathname);
if (!guard.ok) return Astro.redirect(guard.redirect);
---

<AdminLayout title="Клиенты" email={guard.user.email} active="customers">
  <CustomersTable client:load />
</AdminLayout>
