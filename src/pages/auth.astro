---
import Layout from '../layouts/Layout.astro';
import AuthForm from '../islands/AuthForm.vue';

export const prerender = false;

const access = Astro.cookies.get('access')?.value;
const url = new URL(Astro.request.url);
const nextRaw = url.searchParams.get('next') ?? '/account';
const next = nextRaw.startsWith('/') ? nextRaw : '/account';

// Already signed in → skip the form.
if (access) return Astro.redirect(next);
---

<Layout title="Вход в аккаунт">
  <div class="mx-auto max-w-[1360px] px-5 py-16">
    <AuthForm client:load next={next} />
  </div>
</Layout>
