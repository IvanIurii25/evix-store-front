# Backend API base (browser islands + SSR fetch). PUBLIC_ vars are exposed to the client.
PUBLIC_API_BASE=http://localhost:58000/api/v1

# OpenAPI schema URL used by `pnpm gen:api` to generate src/types/api.d.ts.
API_OPENAPI=http://localhost:58000/openapi.json

# Default locale (ru | ro).
PUBLIC_DEFAULT_LANG=ro
